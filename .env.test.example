# ============================================================
# TEST / STAGING environment template.
#   cp .env.test.example .env.test
#
# SAFETY (rule 0): point this ONLY at a dedicated staging/test
# database. tests/seed.mjs and tests/cleanup.mjs refuse to run
# when TURSO_DATABASE_URL matches the production database in
# .env (override exists but must never be used:
# TEST_ALLOW_PRODUCTION_DB=1). .env.test is gitignored.
# ============================================================

# --- Test database (staging Turso DB or a local file, migrations applied) ---
# Local file (fully offline):  TURSO_DATABASE_URL="file:./tests/.artifacts/test.db"
# Staging Turso cloud:         TURSO_DATABASE_URL="libsql://<staging-db>.turso.io"
TURSO_DATABASE_URL="file:./tests/.artifacts/test.db"
TURSO_AUTH_TOKEN="<turso auth token - leave empty for file: databases>"

# Signs organizer login tokens (HMAC-SHA256) — must match the dev server's.
SESSION_SECRET="<64+ random characters>"

# --- Email: ALL outbound mail is captured locally. No real email ever leaves this machine.
# The Resend SDK natively honours RESEND_BASE_URL (resend >= v6), so it is pointed at
# tests/mocks/resend-mock-server.mjs. Every payload (recipient, name, roll no, password,
# exam name, exam link) is recorded in tests/.artifacts/resend-payloads.jsonl for assertions.
RESEND_API_KEY="re_test_local_mock_not_a_real_key"
RESEND_FROM="ExamPortal Tests <no-reply@loadtest.example>"
RESEND_BASE_URL="http://127.0.0.1:4599"
APP_URL="http://localhost:5173"

# --- Resend mock server ---
RESEND_MOCK_PORT="4599"
RESEND_MOCK_CAPTURE="tests/.artifacts/resend-payloads.jsonl"
# Comma-separated recipients that must fail (partial-failure summary tests):
RESEND_MOCK_FAIL_EMAILS=""
# Optional random failure rate 0..1:
RESEND_MOCK_FAIL_RATE="0"

# --- Seed fixtures (all data carries the loadtest_ marker) ---
SEED_ORGANIZER_EMAIL="loadtest_organizer@loadtest.example"
SEED_ORGANIZER2_EMAIL="loadtest_organizer2@loadtest.example"
SEED_LOAD_STUDENTS="300"
# Passwords are generated per run and written ONLY to the gitignored
# tests/.artifacts/loadtest-credentials.json - never printed, never committed.
